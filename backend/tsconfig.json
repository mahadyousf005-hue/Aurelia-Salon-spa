{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "../src/server/**/*.ts",
    "../src/data/salonData.ts",
    "../src/types/index.ts"
  ]
}
